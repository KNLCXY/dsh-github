{
  "$schema": "https://raw.githubusercontent.com/T-Auto/dsh-std/8a15541117cb3c13ddb8f2468308691b6051d162/packages/manifest/schema/dsh-plugin-0.15.schema.json",
  "manifestVersion": "0.15",
  "id": "dsh-github.local",
  "name": "dsh-github",
  "version": "0.1.1",
  "license": "MIT",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "tools.dsh/v1alpha1",
        "kind": "Tool"
      }
    ]
  },
  "permissions": [
    {
      "name": "dsh-github.network.fetch",
      "scope": "outbound-network",
      "reason": "调用 GitHub REST API（api.github.com 或你自填的地址）；只访问 https://api.github.com 域名下的路径和你的设置。"
    }
  ],
  "contributes": {
    "x-display": [
      {
        "icon": "./docs/icon.png",
        "title": "GitHub",
        "description": "GitHub 工具：调 REST API、一次提交多个文件、建仓库、查 token 身份。token 只存在插件自己的设置里（设置里那格只有示例，没有默认值），不进仓库、不进工具输出。",
        "locales": [
          "locale/en.json",
          "locale/zh.json"
        ]
      }
    ]
  }
}
